<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:smartFactoryApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="900"
        d:DesignHeight="600"
        x:Class="smartFactoryApp.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900"
        Height="600"
        Title="smartFactoryApp">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid>

        <Image Source="avares://smartFactoryApp/Assets/factory_plan.png"
               Stretch="None"/>

        <Canvas x:Name="canvasFactory"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Width="900"
                Height="600">

            <!-- ========================================== -->
            <!-- FACTORY ZONES -->
            <!-- ========================================== -->

            <!-- LINKS: FOR RECYCLING -->
            <Image Source="avares://smartFactoryApp/Assets/For_Recycling.png"
                   Width="150"
                   Height="60"
                   Canvas.Left="50"
                   Canvas.Top="40"
                   Stretch="Fill"/>

            <!-- MITTE: RECYCLE / DELIVERY / CUSTOMER -->
            <Image Source="avares://smartFactoryApp/Assets/factory_zones.png"
                   Width="180"
                   Height="60"
                   Canvas.Left="200"
                   Canvas.Top="40"
                   Stretch="Fill"/>

            <!-- RECHTS: TO CUSTOMERS -->
            <Image Source="avares://smartFactoryApp/Assets/To_Customers.png"
                   Width="150"
                   Height="60"
                   Canvas.Left="380"
                   Canvas.Top="40"
                   Stretch="Fill"/>


            <!-- ========================================== -->
            <!-- MULTICOLOR -->
            <!-- ========================================== -->

            <Image Source="avares://smartFactoryApp/Assets/production_all_colors.png"
                   Width="180"
                   Height="60"
                   Canvas.Left="200"
                   Canvas.Top="330"
                   Stretch="Fill"/>


            <!-- ================================================= -->
            <!-- RED PRODUCTION LINE -->
            <!-- ================================================= -->

            <Rectangle x:Name="rectRedProductionLine"
                       Width="160"
                       Height="60"
                       Canvas.Left="{Binding ProductionLines[0].X}"
                       Canvas.Top="{Binding ProductionLines[0].Y}"
                       Stroke="Black">

                <Rectangle.Fill>
                    <ImageBrush Source="avares://smartFactoryApp/Assets/production_red_2.png"/>
                </Rectangle.Fill>

            </Rectangle>


            <!-- ================================================= -->
            <!-- YELLOW PRODUCTION LINE -->
            <!-- ================================================= -->

            <Rectangle x:Name="rectYellowProductionLine"
                       Width="160"
                       Height="60"
                       Canvas.Left="{Binding ProductionLines[1].X}"
                       Canvas.Top="{Binding ProductionLines[1].Y}"
                       Stroke="Black">

                <Rectangle.Fill>
                    <ImageBrush Source="avares://smartFactoryApp/Assets/production_yellow_2.png"/>
                </Rectangle.Fill>

            </Rectangle>


            <!-- ================================================= -->
            <!-- BLUE PRODUCTION LINE -->
            <!-- ================================================= -->

            <Rectangle x:Name="rectBlueProductionLine"
                       Width="60"
                       Height="160"
                       Canvas.Left="{Binding ProductionLines[2].X}"
                       Canvas.Top="{Binding ProductionLines[2].Y}"
                       Stroke="Black">

                <Rectangle.Fill>
                    <ImageBrush Source="avares://smartFactoryApp/Assets/production_blue_2.png"/>
                </Rectangle.Fill>

            </Rectangle>


            <!-- ================================================= -->
            <!-- GREEN PRODUCTION LINE -->
            <!-- ================================================= -->

            <Rectangle x:Name="rectGreenProductionLine"
                       Width="60"
                       Height="160"
                       Canvas.Left="{Binding ProductionLines[3].X}"
                       Canvas.Top="{Binding ProductionLines[3].Y}"
                       Stroke="Black">

                <Rectangle.Fill>
                    <ImageBrush Source="avares://smartFactoryApp/Assets/production_green_2.png"/>
                </Rectangle.Fill>

            </Rectangle>


            <!-- ================================================= -->
            <!-- ALLE BRICKS (eine Vorlage fuer alle) -->
            <!-- ================================================= -->

            <ItemsControl ItemsSource="{Binding Bricks}"
                          Width="900"
                          Height="600">

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <Canvas/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter" x:DataType="vm:LegoBrickViewModel">
                        <Setter Property="Canvas.Left" Value="{Binding X}"/>
                        <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                    </Style>
                </ItemsControl.Styles>

                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LegoBrickViewModel">
                        <Rectangle Width="{Binding BrickWidth}"
                                   Height="{Binding BrickHeight}"
                                   Margin="{Binding BrickMargin}"
                                   Fill="{Binding FillBrush}"
                                   Stroke="Black"
                                   RenderTransformOrigin="50%,50%">

                            <Rectangle.RenderTransform>
                                <RotateTransform Angle="{Binding Angle}"/>
                            </Rectangle.RenderTransform>

                        </Rectangle>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

            </ItemsControl>


            <!-- ================================================= -->
            <!-- ROBOT -->
            <!-- ================================================= -->

            <Rectangle x:Name="rectRobot"
                       Width="30"
                       Height="66"
                       Canvas.Left="{Binding RobotX}"
                       Canvas.Top="{Binding RobotY}"
                       Stroke="Black"
                       RenderTransformOrigin="50%,50%">

                <Rectangle.RenderTransform>
                    <RotateTransform Angle="{Binding RobotAngle}"/>
                </Rectangle.RenderTransform>

                <Rectangle.Fill>
                    <ImageBrush Source="avares://smartFactoryApp/Assets/robot_2.png"/>
                </Rectangle.Fill>

            </Rectangle>


            <!-- ================================================= -->
            <!-- X / Y / ANGLE (unten links, rot) -->
            <!-- ================================================= -->

            <StackPanel Canvas.Left="55" Canvas.Top="505">
                <TextBlock Text="{Binding RobotX, StringFormat='X: {0:F1}'}" Foreground="Red" FontSize="13"/>
                <TextBlock Text="{Binding RobotY, StringFormat='Y: {0:F1}'}" Foreground="Red" FontSize="13"/>
                <TextBlock Text="{Binding RobotAngle, StringFormat='Angle: {0:F1}&#176;'}" Foreground="Red" FontSize="13"/>
            </StackPanel>


            <!-- ================================================= -->
            <!-- RECHTE SEITE: Order, Buttons, Steuerung -->
            <!-- ================================================= -->

            <StackPanel Canvas.Left="612" Canvas.Top="8" Width="275" Spacing="6">

                <!-- ORDER-TABELLE -->

                <Grid ColumnDefinitions="95,75,75" RowDefinitions="26,26,26,26,26" ColumnSpacing="5" RowSpacing="4">

                    <Border Grid.Row="0" Grid.Column="0" Background="LightGray" CornerRadius="3">
                        <TextBlock Text="Order" FontSize="15" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Delivered" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom"/>

                    <!-- yellow -->
                    <Border Grid.Row="1" Grid.Column="0" Background="Gold" CornerRadius="3">
                        <TextBlock Text="yellow" FontWeight="Bold" Foreground="Black"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <TextBlock Text="{Binding YellowOrdered}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <TextBlock Text="{Binding YellowDelivered}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>

                    <!-- blue -->
                    <Border Grid.Row="2" Grid.Column="0" Background="RoyalBlue" CornerRadius="3">
                        <TextBlock Text="blue" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <TextBlock Text="{Binding BlueOrdered}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <TextBlock Text="{Binding BlueDelivered}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>

                    <!-- red -->
                    <Border Grid.Row="3" Grid.Column="0" Background="Firebrick" CornerRadius="3">
                        <TextBlock Text="red" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <TextBlock Text="{Binding RedOrdered}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="3" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <TextBlock Text="{Binding RedDelivered}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>

                    <!-- green -->
                    <Border Grid.Row="4" Grid.Column="0" Background="ForestGreen" CornerRadius="3">
                        <TextBlock Text="green" FontWeight="Bold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <TextBlock Text="{Binding GreenOrdered}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>
                    <Border Grid.Row="4" Grid.Column="2" BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="6,0">
                        <TextBlock Text="{Binding GreenDelivered}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Border>

                </Grid>


                <!-- STEP-TEXT -->

                <TextBlock Text="{Binding StepText}"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="MidnightBlue"
                           TextWrapping="Wrap"
                           MinHeight="48"/>


                <!-- HINWEIS (z.B. "drive forward to dock the brick") -->

                <TextBlock Text="{Binding HintText}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           MinHeight="32"/>


                <!-- BUTTONS (2 Spalten) -->

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="6" RowSpacing="6">

                    <Grid.Styles>
                        <Style Selector="Button">
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Center"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="FontSize" Value="12"/>
                        </Style>
                    </Grid.Styles>

                    <!-- Setup ist grau, solange eine Order läuft -->
                    <Button Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                            x:Name="SetupButton"
                            IsEnabled="{Binding SetupAktiv}"
                            Click="SetupProductionLines_Click">
                        <TextBlock Text="Setup Production Lines" TextWrapping="Wrap" TextAlignment="Center"/>
                    </Button>

                    <!-- Automatische Fahrt des Roboters -->
                    <Button Grid.Row="0" Grid.Column="1" Content="GoToPickUp" Click="GoToPickUp_Click"/>
                    <Button Grid.Row="1" Grid.Column="1" Content="GoToDelivery" Click="GoToDelivery_Click"/>

                    <Button Grid.Row="2" Grid.Column="0" x:Name="StartTimerButton"
                            Content="Start" Click="StartTimer_Click"/>
                    <Button Grid.Row="2" Grid.Column="1" x:Name="StopTimerButton"
                            Content="Stop" Click="StopTimer_Click"/>

                </Grid>


                <!-- UNDOCK-MELDUNG -->

                <TextBlock Text="{Binding UndockMessage}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           MinHeight="30"/>


                <!-- STEUERUNG: links Move/Step + Undock, rechts Pfeile -->

                <Grid ColumnDefinitions="95,*">

                    <StackPanel Grid.Column="0" Spacing="10" VerticalAlignment="Center">

                        <RadioButton Content="Move"
                                     GroupName="RobotMode"
                                     Click="MoveMode_Click"/>

                        <RadioButton Content="Step"
                                     GroupName="RobotMode"
                                     IsChecked="True"
                                     Click="StepMode_Click"/>

                        <Button x:Name="UndockButton"
                                Content="Undock"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Click="UndockButton_Click"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1" Spacing="6">

                        <Grid ColumnDefinitions="44,44,44"
                              RowDefinitions="36,36,36">

                            <Grid.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Width" Value="40"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="FontSize" Value="16"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                </Style>
                            </Grid.Styles>

                            <Button Grid.Row="0" Grid.Column="0" Content="&#8598;" Click="MoveUpLeft_Click"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="&#8593;" Click="MoveUp_Click"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="&#8599;" Click="MoveUpRight_Click"/>

                            <Button Grid.Row="1" Grid.Column="0" Content="&#8592;" Click="MoveLeft_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="&#9632;" Click="StopRobot_Click"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="&#8594;" Click="MoveRight_Click"/>

                            <Button Grid.Row="2" Grid.Column="0" Content="&#8601;" Click="MoveDownLeft_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="&#8595;" Click="MoveDown_Click"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="&#8600;" Click="MoveDownRight_Click"/>

                        </Grid>

                        <!-- ROTATION -->

                        <Grid ColumnDefinitions="44,44,44">

                            <Button Grid.Column="0" Content="&#8630;" Width="40" Height="32" FontSize="16" Padding="0"
                                    HorizontalContentAlignment="Center"
                                    Click="RotateLeft_Click"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding RobotAngle, StringFormat='{}{0:F0}&#176;'}"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <Button Grid.Column="2" Content="&#8631;" Width="40" Height="32" FontSize="16" Padding="0"
                                    HorizontalContentAlignment="Center"
                                    Click="RotateRight_Click"/>

                        </Grid>

                    </StackPanel>

                </Grid>

            </StackPanel>

        </Canvas>

    </Grid>

</Window>